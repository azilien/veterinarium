# Gradle cache and build outputs — generated by ./gradlew build, do not commit
.gradle/
build/
run/
run-data/
logs/
out/
*.log
.mpt/

# CurseForge export archive — generated locally for manual upload, do not commit
veterinarium-*-for-max.zip

# Local development override — contains your personal PrismLauncher instance path
# This file is created from local-dev.gradle.example and holds the copyToPrism task
# which syncs the built jar to your local PrismLauncher mods folder for quick testing
local-dev.gradle

# Private planning documents — personal notes, episode scripts and internal roadmaps
# The gitignore/ folder (without dot) holds files like "Série 10 épisodes.txt" which are
# work-in-progress planning docs not intended for public release; they stay local only
gitignore/
